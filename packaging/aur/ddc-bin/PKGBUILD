# Maintainer: ejfkdev (https://github.com/ejfkdev)
pkgname=ddc-bin
pkgver=0.1.34
pkgrel=1
pkgdesc='DEX to Java decompiler with a CLI, HTTP API and MCP server'
arch=(aarch64 x86_64)
url=https://github.com/ejfkdev/ddc
license=(MIT)
depends=(glibc gcc-libs)
provides=(ddc)
conflicts=(ddc)
options=('!strip' '!debug')
source=(LICENSE::https://raw.githubusercontent.com/ejfkdev/ddc/v0.1.34/LICENSE)
source_aarch64=("ddc-${pkgver}-aarch64::https://github.com/ejfkdev/ddc/releases/download/v0.1.34/ddc-v0.1.34-aarch64-unknown-linux-gnu")
source_x86_64=("ddc-${pkgver}-x86_64::https://github.com/ejfkdev/ddc/releases/download/v0.1.34/ddc-v0.1.34-x86_64-unknown-linux-gnu")
sha256sums=(2f55f4862e6e627670c2439847c70c6ab9bcffa5f39eac0fcc8ff11af80fc41e)
sha256sums_aarch64=(efdb6ec93e1ebd17715a74ae8593e4fc6b7b7945354eeb60686ad2fd5f8551ce)
sha256sums_x86_64=(77f54753c2daabeccb3efafa43136de15907e2d6ed8a78f66d4848228b03f096)

package() {
  install -Dm755 "${srcdir}/ddc-${pkgver}-${CARCH}" "${pkgdir}/usr/bin/ddc"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
